---
import BookingLink from './BookingLink.astro';
import { pageUrl } from '../config';
const topics = [
 ['01', 'Map your DM process', 'Talk through how enquiries arrive, which questions repeat and where conversations get stuck.'],
 ['02', 'Discuss your needs', 'Explore your offer, qualification questions and the points where you want a person involved.'],
 ['03', 'Assess the proposed fit', 'Discuss whether the planned concept could suit your workflow, including its current limits.'],
];
---
<section id="contact" class="container section founder-section" aria-labelledby="founder-title">
 <div class="founder-intro"><p class="eyebrow">THE PERSON BEHIND CLOSEFLOW</p><p>A considered approach.<br />A personal conversation.</p></div>
 <div class="founder-panel">
  <figure class="founder-photo"><img class="founder-portrait" src={pageUrl('founder-portrait.webp')} width="640" height="800" alt="Black-and-white portrait of Nikola Pešić" loading="lazy" decoding="async" /><figcaption><div><strong>Nikola Pešić</strong><span>Independent project founder · Serbia</span></div><span class="founder-arrow" aria-hidden="true">↗</span></figcaption></figure>
  <div class="founder-story"><p class="founder-label">A NOTE FROM THE FOUNDER</p><h2 id="founder-title">Hi, I’m Nikola.<br /><span>Let’s start with your workflow.</span></h2><p>I’m developing CLOSEFLOW AI to explore a more structured way for online fitness coaches to handle inbound enquiries — with your voice, boundaries and judgement at the centre.</p><p>Before defining a future product, I want to understand how you work: the questions you hear, the conversations that get stuck and where you want to stay personally involved.</p><div class="founder-status"><span aria-hidden="true">◎</span><p><strong>Early stage. Open about it.</strong>I’m testing a local, rules-based prototype with fictional conversations. The AI product, live integrations and software access are not available.</p></div><div class="founder-actions"><a class="button" href="#call-details">Let’s talk about your workflow <span aria-hidden="true">↗</span></a><a class="founder-email" href="mailto:nikolapesic878@gmail.com">Email me directly ↗</a></div><p class="founder-meta">CLOSEFLOW AI is a project name, not a registered company. <a href={pageUrl('contact/')}>Contact and call details</a></p></div>
 </div>
</section>
<section id="call-details" class="container section call-details" aria-labelledby="call-title">
 <div class="section-heading"><div><p class="eyebrow">YOUR FREE PRELAUNCH CALL</p><h2 id="call-title">A clearer picture.<br />Before any commitment.</h2></div><p>A conversation with Nikola about your coaching workflow and the proposed concept. You can ask questions and decide whether to stay in touch.</p></div>
 <div class="call-topics">{topics.map(([n,title,text])=><article><span class="call-number">{n}</span><h3>{title}</h3><p>{text}</p></article>)}</div>
 <div class="call-preparation"><div><h3>What to bring</h3><p>A brief description of your coaching offer and one or two questions about your enquiry process. No preparation document is needed. Please leave out private client messages, passwords and health information.</p></div><div><p class="call-format">15 minutes · Free · On Zoom</p><BookingLink /><p class="call-note">Choose a time on Calendly. Zoom details arrive with the booking confirmation. No payment, software access or live product demonstration is included. Calls are not recorded or transcribed by the operator.</p></div></div>
</section>
<style>

 .founder-section{border-top:1px solid var(--line)}
 .founder-intro{display:flex;justify-content:space-between;align-items:flex-start;gap:24px;margin-bottom:28px}.founder-intro .eyebrow{margin:0}.founder-intro>p:last-child{font-size:13px;color:var(--muted);margin:0;line-height:1.6}
 .founder-panel{display:grid;grid-template-columns:minmax(0,.83fr) minmax(0,1.17fr);border:1px solid var(--line);border-radius:22px;overflow:hidden;background:linear-gradient(120deg,#ff6b5b0d,transparent 60%),var(--color-cream);box-shadow:0 18px 55px #14213d08}
 .founder-photo{position:relative;display:flex;flex-direction:column;margin:0;min-width:0;background:var(--color-navy)}
 .founder-portrait{display:block;width:100%;height:100%;min-height:420px;max-height:580px;object-fit:cover;object-position:50% 35%;flex:1}
 .founder-photo figcaption{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:23px 28px;background:var(--color-navy);color:var(--color-cream)}.founder-photo figcaption strong{display:block;font-size:20px;font-weight:600;letter-spacing:-.4px}.founder-photo figcaption div>span{display:block;font-size:12px;margin-top:6px;line-height:1.6}.founder-arrow{display:grid;place-items:center;flex-shrink:0;width:36px;height:36px;border-radius:50%;background:var(--color-coral);color:var(--color-navy);font-size:25px}
 .founder-story{padding:44px 42px;align-self:center;min-width:0}.founder-label{font-size:9px;letter-spacing:1.6px;font-weight:700;margin-bottom:20px}.founder-story h2{font-size:clamp(30px,3.2vw,43px);letter-spacing:-1.6px;line-height:1.15;margin-bottom:23px}.founder-story h2>span{font-family:Georgia,serif;font-style:italic;font-weight:400}.founder-story>p:not(.founder-label){font-size:14px;color:var(--muted);line-height:1.75}
 .founder-status{display:flex;align-items:flex-start;gap:12px;padding:16px 0;margin-block:22px;border-block:1px solid var(--line)}.founder-status>span{font-size:23px;line-height:1.3}.founder-status p{font-size:12px;line-height:1.7;margin:0;color:var(--muted)}.founder-status strong{display:block;color:var(--color-navy);font-size:13px;margin-bottom:5px}
 .founder-actions{display:flex;align-items:center;flex-wrap:wrap;gap:12px 22px}.founder-actions .button{gap:16px;font-size:13px;padding-inline:18px}.founder-email{display:inline-flex;align-items:center;min-height:44px;font-size:12px;font-weight:600;text-decoration:underline;text-underline-offset:5px}.founder-story .founder-meta{font-size:11px!important;margin:20px 0 0}.founder-meta a{text-decoration:underline;text-underline-offset:3px}
 @media(max-width:1050px){.founder-story{padding:32px 26px}.founder-panel{grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr)}.founder-photo figcaption{padding:20px}.founder-photo figcaption strong{font-size:18px}.founder-photo figcaption div>span{font-size:11px}.founder-portrait{min-height:450px;max-height:650px}}
 @media(max-width:800px){.founder-panel{grid-template-columns:1fr}.founder-photo{display:grid;grid-template-columns:170px 1fr}.founder-portrait{height:210px;min-height:0;max-height:none}.founder-photo figcaption{padding:28px;align-items:center}.founder-photo figcaption strong{font-size:25px}.founder-photo figcaption div>span{font-size:12px}.founder-story{padding:32px}.founder-story h2{font-size:38px}}
 @media(max-width:540px){.founder-intro{display:block}.founder-intro>p:last-child{margin-top:12px;font-size:12px}.founder-panel{border-radius:18px}.founder-photo{grid-template-columns:115px 1fr}.founder-portrait{height:160px}.founder-photo figcaption{padding:16px;gap:8px}.founder-photo figcaption strong{font-size:20px}.founder-photo figcaption div>span{font-size:10px}.founder-arrow{display:none}.founder-story{padding:27px 23px}.founder-story h2{font-size:32px;letter-spacing:-1px}.founder-story>p:not(.founder-label){font-size:14px}.founder-actions{gap:8px}.founder-actions .button{width:100%;padding-inline:12px;font-size:12px}.founder-label{font-size:8px;letter-spacing:1.2px}}
 .call-details{padding-top:0}.call-topics{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px}.call-topics article{padding:26px;border:1px solid var(--line);border-radius:12px;background:var(--color-cream)}
 .call-number{display:grid;place-items:center;width:32px;height:32px;border-radius:9px;background:var(--color-coral);font-size:11px;font-weight:700;margin-bottom:24px}.call-topics h3{font-size:20px;letter-spacing:-.4px;margin-bottom:12px}.call-topics p{font-size:14px;color:var(--muted);margin:0}
 .call-preparation{display:grid;grid-template-columns:1fr 1fr;gap:65px;padding:32px;margin-top:24px;border-radius:14px;background:#14213d08}.call-preparation h3{font-size:19px;margin-bottom:12px}.call-preparation p{font-size:14px;color:var(--muted);margin-bottom:0}.call-preparation .call-format{color:var(--color-navy);font-weight:700;margin-bottom:16px}.call-preparation .call-note{font-size:12px;margin-top:16px;max-width:460px}
 @media(max-width:1050px){.call-preparation{gap:32px}}
 @media(max-width:800px){.call-topics{gap:14px}.call-topics article{padding:20px}.call-topics h3{font-size:18px}.call-topics p{font-size:13px}}
 @media(max-width:540px){.call-topics,.call-preparation{grid-template-columns:1fr}.call-preparation{padding:24px;gap:26px}.call-topics article{padding:24px}.call-number{margin-bottom:18px}.call-topics p{font-size:14px}}
</style>
