---
const steps = [
 { label: 'Interested enquiry', lead: 'Hey! I saw your coaching post. I want to get stronger but I’m struggling to stay consistent.', reply: 'Thanks for reaching out! What does your training look like at the moment, and what would you like to change?', goal: 'Build strength', timing: 'Not discussed', status: 'Learning about the enquiry', note: 'Fictional scenario: ask one useful question before suggesting a next step.' },
 { label: 'Pricing question', lead: 'How much does your coaching cost? Do you have a package that would suit me?', reply: 'The coach needs to confirm the current packages and pricing. What kind of support are you looking for? I can flag your question for them.', goal: 'Understand coaching options', timing: 'Not discussed', status: 'Pricing confirmation needed', note: 'Fictional scenario: do not invent prices, discounts or guarantees. The coach confirms the offer.' },
 { label: 'Talk to the coach', lead: 'Could I speak with the coach directly before deciding? I have a few personal questions.', reply: 'Of course. You can discuss those questions directly with the coach. Would you like information about arranging a consultation? Please keep private health details out of this example chat.', goal: 'Speak with the coach', timing: 'To be arranged', status: 'Human conversation requested', note: 'Fictional scenario: respect the request for a person. No booking or handoff is actually created.' },
];
---
<section id="demo" class="section demo-section">
 <div class="section-heading"><div><p class="eyebrow">SCRIPTED CONCEPT PREVIEW</p><h2>A little less back-and-forth.<br />A clearer next step.</h2></div><p>Choose a fictional situation to see an example response: an interested enquiry, a pricing question or a request to speak with the coach. These are fixed scripts, not AI responses. The AI product and live integrations are not available.</p></div>
 <div class="demo-controls" role="group" aria-label="Choose a fictional conversation scenario">{steps.map((step, i) => <button type="button" data-step={i} aria-pressed={i === 0} aria-controls="demo-stage"><span>0{i + 1}</span>{step.label}<span aria-hidden="true">↗</span></button>)}</div>
 <div class="workspace"><div class="workspace-bar"><span><b class="mini-mark">↗</b> CLOSEFLOW <span class="muted">/ Coaching workspace</span></span><span class="sample-badge">SIMULATED DEMO</span></div>
 <div class="workspace-body"><aside class="inbox"><p class="small-label">EXAMPLE INBOX</p><div class="lead selected"><span class="avatar">JL</span><div><b>Jordan Lee</b><small>Interested in coaching</small></div><span class="lead-dot"></span></div><div class="lead"><span class="avatar neutral">AT</span><div><b>Alex Taylor</b><small>Another fictional enquiry</small></div></div><div class="inbox-note">Built around your<br /><strong>coaching playbook.</strong></div></aside>
 <div id="demo-stage" class="conversation" aria-live="polite" aria-atomic="true"><div class="conversation-heading"><div><b>Jordan Lee</b><small>Fictional prospective client</small></div><span class="outline-pill">Inbound enquiry</span></div>
 {steps.map((step,i) => <div class="stage" data-panel={i} hidden={i !== 0}><p class="chat-label">JORDAN · EXAMPLE MESSAGE</p><p class="bubble incoming">{step.lead}</p><p class="chat-label agent-label">CLOSEFLOW AI · EXAMPLE REPLY</p><p class="bubble outgoing">{step.reply}</p><div class="playbook-note"><span aria-hidden="true">✧</span><p>{step.note}</p></div></div>)}
 <p class="demo-disclaimer">This preview does not use AI, read or send DMs, store lead data, or book appointments. The separate Calendly link books a prelaunch conversation with the founder.</p></div>
 <aside class="context"><p class="small-label">LEAD CONTEXT</p><h3>The details that matter.</h3>{steps.map((step,i) => <div data-context={i} hidden={i !== 0}><dl><dt>Goal</dt><dd>{step.goal}</dd><dt>Start timeline</dt><dd>{step.timing}</dd><dt>Conversation status</dt><dd class="status">{step.status}</dd></dl></div>)}<div class="human-note"><span aria-hidden="true">◎</span><b>Human judgement stays central.</b><p>Sensitive questions and exceptions should go to you.</p></div></aside></div></div>
 <noscript><p class="fine-print">The first example is shown. Enable JavaScript to explore the other two fictional scenarios.</p></noscript>
</section>
<script>
 const buttons = document.querySelectorAll<HTMLButtonElement>('[data-step]');
 buttons.forEach(button => button.addEventListener('click', () => {
   const active = button.dataset.step;
   buttons.forEach(item => item.setAttribute('aria-pressed', String(item === button)));
   document.querySelectorAll<HTMLElement>('[data-panel]').forEach(panel => { panel.hidden = panel.dataset.panel !== active; });
   document.querySelectorAll<HTMLElement>('[data-context]').forEach(panel => { panel.hidden = panel.dataset.context !== active; });
 }));
</script>
